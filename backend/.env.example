NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/nichelink?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/nichelink
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d
APP_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=false
LOG_LEVEL=info
REQUEST_SIZE_LIMIT=10kb
COOKIE_SECRET=replace_with_a_secure_random_cookie_secret
CSRF_ENABLED=false
CSRF_COOKIE_NAME=XSRF-TOKEN
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=250
AUTH_RATE_LIMIT_MAX=40
EMAIL_RATE_LIMIT_MAX=10
REDIS_URL=redis://localhost:6379
EMAIL_FROM=no-reply@nichelink.local
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMAIL_QUEUE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_SUCCESS_URL=http://localhost:3000/billing?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/billing?checkout=cancelled
