NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://user:password@production-host:5432/nichelink
DIRECT_URL=postgresql://user:password@production-host:5432/nichelink
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d
APP_URL=https://api.yourdomain.com
CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com
CORS_ALLOW_CREDENTIALS=true
LOG_LEVEL=info
REQUEST_SIZE_LIMIT=10kb
COOKIE_SECRET=replace_with_a_secure_random_cookie_secret
CSRF_ENABLED=true
CSRF_COOKIE_NAME=XSRF-TOKEN
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=250
AUTH_RATE_LIMIT_MAX=40
EMAIL_RATE_LIMIT_MAX=10
REDIS_URL=redis://redis:6379
EMAIL_FROM=no-reply@yourdomain.com
SMTP_HOST=smtp.mailprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMAIL_QUEUE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_SUCCESS_URL=https://yourdomain.com/billing?checkout=success
STRIPE_CANCEL_URL=https://yourdomain.com/billing?checkout=cancelled
